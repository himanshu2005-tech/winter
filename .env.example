# WINTER cloud-first model configuration. Do not commit the real .env file.
WINTER_PROVIDER=airouter
WINTER_MODEL=anthropic/claude-haiku-5.5
# AIRouter remains primary; authenticated ChatGPT provides continuity fallback.
VANTA_PREFER_CHATGPT=0
# Stronger default for ChatGPT fallback. Override only with another
# model exposed by the signed-in account.
CHATGPT_MODEL=gpt-6.1-sol
# Never select Astra merely because it appears first in the account catalog.
CHATGPT_EXCLUDED_MODELS=gpt-6-astra
AIROUTER_API_KEY=replace_with_your_key
# Override only if your Airouter account specifies a different OpenAI-compatible endpoint.
AIROUTER_BASE_URL=https://api.airouter.in/v1

# Optional integrations (leave blank to disable):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Extracted web research and Google organic search/fallback.
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Model-directed initiative. The model chooses whether to stay quiet and when
# another cross-resource review is useful; code clamps timing and permissions.
VANTA_PROACTIVE_MIN_SECONDS=300
VANTA_PROACTIVE_MAX_SECONDS=7200
VANTA_PROACTIVE_INITIAL_SECONDS=180
VANTA_PROACTIVE_REPEAT_SECONDS=21600

# Structured Google Shopping watches share the SerpApi quota, so durable
# product checks are deliberately less frequent than local page/file watches.
VANTA_PRODUCT_PRICE_MIN_HOURS=12
# Official Kaggle personal token. Used only inside Build Mode's provider;
# never put this value in a prompt, command receipt, or checked-in file.
KAGGLE_API_TOKEN=
# Safety bounds for unattended Kaggle builds.
VANTA_KAGGLE_MAX_BYTES=786432000
VANTA_KAGGLE_MAX_EXTRACTED_BYTES=2147483648
# Repeated web questions return from this in-memory cache.
VANTA_SEARCH_CACHE_SECONDS=900
# TELEGRAM_BOT_TOKEN=
# Maximum size VANTA will upload or download through Telegram. Telegram may
# impose a lower provider limit for a particular bot or file type.
VANTA_TELEGRAM_MAX_FILE_MB=50
# Lifecycle unlock fallback. The value is compared locally in constant time
# and must never be committed, spoken, logged, or sent to a model.
AUTH_PASSWORD=
# Notify the already-paired Telegram chat if face verification has not passed.
VANTA_AUTH_TELEGRAM_AFTER_SECONDS=10
# Official YouTube Data API v3 key. Restrict this key to YouTube Data API v3.
# YOUTUBE_API_KEY=

# Coder model for build mode. AIRouter's catalogue could not be reached to
# confirm the exact id, so correct it here if the default is rejected.
WINTER_MODEL_CODER=minimax/minimax-m2.5
# Provider-specific role models prevent an AIRouter id being sent to ChatGPT
# (or a ChatGPT account id being sent to AIRouter).
AIROUTER_MODEL_CODER=minimax/minimax-m2.5
# Pin build-mode generation to AIRouter. If it is offline, fail honestly
# instead of changing the coding model/provider in the middle of a project.
WINTER_PROVIDER_CODER=airouter
CHATGPT_MODEL_CODER=

# Screen-aware turns send images; this stage needs a vision model.
WINTER_MODEL_VISION=alibaba/qwen3-vl-instruct
# Adaptive perception: YOLO26s stays local for common-object grounding, while
# the vision LLM handles text, UI, diagrams, charts, code, and semantics.
VANTA_YOLO_ENABLED=1
# CPU is the crash-safe default. Only set 0 after validating that this
# machine's PyTorch, CUDA and cuDNN versions are binary-compatible.
# VANTA_YOLO_DEVICE=
# VANTA_YOLO_CONF=0.30
# Mean frame luminance (0..255) below which local low-light enhancement runs.
# VANTA_LOW_LIGHT_LUMA=58
# Graph Person name whose enrolled face may receive personal briefings.
# VANTA_PRIMARY_PERSON=Himanshu

# Local face identity (SCRFD-10GF + ArcFace via InsightFace buffalo_l).
# The public pretrained weights are licensed for non-commercial research.
VANTA_FACE_ENABLED=1
VANTA_FACE_MATCH_THRESHOLD=0.50
VANTA_FACE_AMBIGUITY_MARGIN=0.08
VANTA_FACE_DET_THRESHOLD=0.60
VANTA_FACE_MIN_PIXELS=80
# Optional comma-separated ONNX Runtime providers. CPU is the safe default.
# VANTA_FACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Local raised-index-finger wake. MediaPipe runs on-device against the shared
# camera stream; gesture frames stay in memory and are never uploaded/stored.
VANTA_GESTURE_WAKE=1
VANTA_GESTURE_CONFIDENCE=0.72
VANTA_GESTURE_CONFIRM_FRAMES=3
VANTA_GESTURE_FPS=5
# Local meanings: Pointing_Up=listen, Open_Palm=stop speaking,
# Closed_Fist=abort, Thumb_Up/Down=resolve a pending prompt,
# Victory=toggle the VANTA dashboard. All require a stable hold and release.

# Providers to try if the main one fails. Empty means no fallback.
WINTER_FALLBACK_PROVIDERS=

# Browser automation. firefox-real drives the installed Mozilla Firefox with
# Selenium. VANTA uses its own profile and copies current cookies from your
# everyday Firefox; it never reads saved passwords or locks your live profile.
WINTER_BROWSER_ENGINE=firefox-real
# WINTER_FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe
# WINTER_BROWSER_IMPORT_COOKIES=1

# Voice input follows connected headset/USB/Bluetooth microphones, otherwise
  # the current Windows default. Set a device index or name only to override it.
  # VANTA_MIC=
# Full large-v3 is used online; large-v3-turbo is the high-quality local
# fallback that fits the current Windows GPU. small.en is emergency-only.
VANTA_STT=auto
VANTA_STT_MODEL=whisper-large-v3
VANTA_STT_LOCAL_MODEL=large-v3-turbo
VANTA_WAKE_STT_MODEL=large-v3-turbo
# A natural pause is not the end of a turn. Applies to wake-word commands and
# nameless follow-ups during the open conversation window.
VANTA_VOICE_ENDPOINT_SILENCE=2.0
VANTA_WAKE_FOLLOW_UP=30

# Automatic screen rest uses the same dark surface as manual Standby mode,
# but only when both user input and the visible screen have stayed idle.
VANTA_STANDBY_IDLE_MINUTES=20
# World Air Quality Index
WAQI_API_TOKEN=
# Retry a wake-word model that could not load after this many seconds.
VANTA_WAKE_MODEL_RETRY_SECONDS=60
# Camera awareness (background frames are local, intermittent and ephemeral).
# Ordinary presence uses one full grab per minute. A 64x64 greyscale in-memory
# fingerprint gates YOLO; it is never written and cannot reconstruct the frame.
VANTA_PRESENCE_CAMERA_INTERVAL=60
# Study mode remains intermittent, but samples often enough to catch a short
# distraction. Frames are analysed ephemerally and never retained here.
VANTA_STUDY_CAMERA_INTERVAL=12
VANTA_CAMERA_OBJECT_CONFIDENCE=0.28
# A continuously visible phone is reviewed at most once per interval. The
# vision model, not the label alone, decides whether a focus nudge is warranted.
VANTA_STUDY_ATTENTION_COOLDOWN_SECONDS=600
VANTA_CAMERA_REASONING_INTERVAL=300
VANTA_STANDBY_MONITOR_INTERVAL=6
VANTA_STANDBY_MONITOR_GRACE_SECONDS=15
VANTA_STANDBY_MONITOR_CONFIRMATIONS=2
VANTA_CAMERA_GATE_MIN_LUMA=12
VANTA_CAMERA_GATE_MIN_CONTRAST=1.5
VANTA_CAMERA_FRAME_DIFF=4.5
VANTA_IDENTITY_CACHE_MINUTES=7
VANTA_IDENTITY_STILL_MINUTES=5
VANTA_IDENTITY_RECHECK_DIFF=18
VANTA_IDENTITY_RETRY_SECONDS=30
VANTA_MODEL_FIRST_REASONING=1
# Permit bounded Gmail snippets (never full bodies or attachment bytes) in the
# configured task-model context for grounded summaries and reply drafting.
# Leave off on shared installations.
VANTA_EMAIL_MODEL_CONTENT=0
# VANTA installable mobile web app. Keep the gateway on loopback and expose it
# privately with Tailscale Serve; never forward this port on the public router.
VANTA_MOBILE_ENABLED=true
VANTA_MOBILE_HOST=127.0.0.1
VANTA_MOBILE_PORT=8765
# Exact deployed web origin, for example https://your-project.web.app
VANTA_MOBILE_ALLOWED_ORIGINS=
